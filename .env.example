# =========================================================
#  ImmoFilms.ch — variables d'environnement
#  Copiez ce fichier en ".env" (en local) ou saisissez ces
#  variables dans hPanel lors du déploiement.
# =========================================================

# Port d'écoute (Hostinger le fournit automatiquement)
PORT=3000
# NODE_ENV n'est pas nécessaire sur Hostinger (laissez-le vide ou supprimez-le)

# ---------- Coordonnées affichées sur le site ----------
WHATSAPP_NUMBER=41795075556
WHATSAPP_DISPLAY=+41 79 507 55 56
CONTACT_EMAIL=contact@immofilms.ch
WHATSAPP_MESSAGE=Bonjour ImmoFilms, je souhaite recevoir une démo gratuite pour une de nos annonces.

# ---------- Envoi des demandes par email (SMTP) ----------
# Boîte mail Hostinger : smtp.hostinger.com, port 465, SSL
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@immofilms.ch
SMTP_PASS=
# Adresse expéditrice (en général identique à SMTP_USER)
MAIL_FROM=ImmoFilms.ch <contact@immofilms.ch>
# Adresse qui reçoit les demandes de démo
MAIL_TO=contact@immofilms.ch

# ---------- Anti-abus ----------
# Nombre maximum d'envois du formulaire par adresse IP et par heure
CONTACT_RATE_LIMIT=5
